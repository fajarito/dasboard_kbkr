# Copy to `.env` for local API (never commit `.env`).
# Secrets stay in env only — do not put real passwords in the repo.

# API listen port (default 8787)
# PORT=8787

# --- Postgres (preferred when set) ---
# Option A: single URL
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5435/BKKBN

# Option B: discrete vars (example: local tunnel on 5435, database BKKBN)
PGHOST=127.0.0.1
PGPORT=5435
PGDATABASE=BKKBN
PGUSER=your_db_user
PGPASSWORD=your_db_password

# Optional override (default below)
# UNMET_NEED_TABLE=dwh_siga.fa_laporan_dallap_bulanan_tabel10_20rdk

# Wilayah dim schema for year-suffixed tables:
#   {DIM_SCHEMA}.d_provinsi_YYYY , {DIM_SCHEMA}.d_kabupaten_YYYY
# Exact year = tahun_rekap; if missing, nearest available year table.
# DIM_SCHEMA=dwh_siga

# If DATABASE_URL / PGHOST+PGDATABASE+PGUSER are unset, the API serves:
#   - tahun=2026&bulan=10 → server/fixtures/oct2026_excel_dummy.json (Excel dummy)
#   - other periods → partial sample under server/fixtures/ (fixture-only %)
#
# Frontend UI defaults to the same Excel dummy for Oct 2026 (no API required).
# Set VITE_USE_LIVE_API=true to force Overview / Unmet Need / mCPR / 4T / KTD /
# Demand Satisfied to call /api (Postgres when configured, else Excel/sample).
# VITE_USE_LIVE_API=true
